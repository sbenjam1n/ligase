#N canvas 0 0 820 600 12;
#X obj 30 20 loadbang;
#X msg 620 20 \; pd dsp 1;
#X obj 30 470 ligase~;
#X obj 320 400 noise~;
#X obj 320 150 primase 120;
#X obj 30 60 delay 100;
#X msg 30 90 recinput;
#X obj 30 130 delay 1100;
#X msg 30 160 record 0 \, playhead 1 \, delay_quantize 4 \, delay_quant 1 \, stut_reps 4;
#X obj 200 60 delay 1150;
#X msg 200 90 tempo 120 \, tap_at 0 \, tap_at 0.125 \, tap_at 0.25 \, tap_at 0.375 \, tap_at 0.5 \, tap_at 0.625 \, tap_at 0.75 \, tap_at 0.875;
#X obj 30 210 delay 1250;
#X msg 30 240 play 1;
#X obj 200 130 delay 1350;
#X msg 200 160 play;
#X msg 320 230 stut;
#X obj 460 230 print PRIMASE_EV;
#X obj 540 300 f;
#X obj 600 300 + 1;
#X obj 540 350 f;
#X obj 540 260 delay 3900;
#X obj 540 400 sel 8;
#X obj 540 440 print PRIMASE_N_PASS;
#X obj 640 440 print PRIMASE_N_FAIL;
#X obj 700 60 delay 4200;
#X msg 700 90 \; pd quit;
#X obj 30 520 dac~;
#X text 30 290 pair_acceptance.pd (Plans/web_build.md Arc B acceptance). primase plays 8 one-shot events -> 8 bangs -> 8 ligase stut triggers (1:1). Each bang is also ligase's clock \, so with delay_quant on the stut spacing locks to primase's grid. In-patch assert: PRIMASE_N_PASS iff exactly 8 events fired. run_acceptance.sh also asserts the stderr stut count == 8 and clock-lock present.;
