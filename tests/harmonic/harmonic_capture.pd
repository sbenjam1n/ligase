#N canvas 0 0 900 780 12;
#X obj 30 20 loadbang;
#X msg 700 20 \; pd dsp 1;
#X obj 30 60 delay 50;
#X msg 240 60 pitch_scale 5 7 9;
#X obj 30 90 delay 90;
#X msg 240 90 pitch_scale_to 1 0 3 5 7;
#X obj 30 120 delay 130;
#X msg 240 120 pitch_scale_slot 1;
#X obj 30 150 delay 170;
#X msg 240 150 scale_root 3;
#X obj 30 180 delay 210;
#X msg 240 180 scale_rotate 2;
#X obj 30 210 delay 350;
#X msg 240 210 snapbuf_from_live;
#X obj 30 240 delay 450;
#X msg 240 240 snapbuf_get pitch_scale_slot;
#X obj 30 270 delay 500;
#X msg 240 270 snapbuf_get scale_root;
#X obj 30 300 delay 550;
#X msg 240 300 snapbuf_get scale_rotate;
#X obj 30 330 delay 600;
#X msg 240 330 snapbuf_get pitch_scale_a;
#X obj 30 360 delay 900;
#X msg 240 360 \; pd quit;
#X obj 700 300 noise~;
#X obj 700 340 ligase~;
#X obj 700 420 route snapbuf;
#X obj 700 450 route pitch_scale_slot scale_root scale_rotate pitch_scale_a;
#X obj 500 500 expr $f1 == 1;
#X obj 500 530 sel 1;
