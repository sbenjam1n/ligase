#N canvas 0 0 900 760 12;
#X obj 30 20 loadbang;
#X msg 700 20 \; pd dsp 1;
#X obj 30 60 delay 50;
#X msg 220 60 waveform_phase 1 0.25;
#X obj 30 90 delay 90;
#X msg 220 90 square_pw 1 0.2;
#X obj 30 120 delay 130;
#X msg 220 120 saw_skew 2 0.5;
#X obj 30 150 delay 170;
#X msg 220 150 lorenz_rho 1 15;
#X obj 30 180 delay 210;
#X msg 220 180 sphere_spin 1 5;
#X obj 30 210 delay 350;
#X msg 220 210 snapbuf_from_live;
#X obj 30 240 delay 450;
#X msg 220 240 snapbuf_get waveform_phase_1;
#X obj 30 270 delay 500;
#X msg 220 270 snapbuf_get square_pw_1;
#X obj 30 300 delay 550;
#X msg 220 300 snapbuf_get saw_skew_2;
#X obj 30 330 delay 600;
#X msg 220 330 snapbuf_get lorenz_rho_1;
#X obj 30 360 delay 650;
#X msg 220 360 snapbuf_get sphere_spin_1;
#X obj 30 390 delay 950;
#X msg 220 390 \; pd quit;
#X obj 700 260 noise~;
#X obj 700 300 ligase~;
#X obj 700 380 route snapbuf;
#X obj 700 410 route waveform_phase_1 square_pw_1 saw_skew_2 lorenz_rho_1 sphere_spin_1;
#X obj 500 470 expr abs($f1-0.25)<0.001;
#X obj 500 500 sel 1;
#X obj 480 540 print WPHASE_PASS;
#X obj 620 540 print WPHASE_FAIL;
#X obj 560 470 expr abs($f1-0.2)<0.001;
#X obj 560 500 sel 1;
#X obj 760 540 print PW_PASS;
#X obj 860 540 print PW_FAIL;
#X obj 620 470 expr abs($f1-0.5)<0.001;
#X obj 620 500 sel 1;
#X obj 480 590 print SKEW_PASS;
#X obj 620 590 print SKEW_FAIL;
#X obj 680 470 expr abs($f1-15)<0.001;
#X obj 680 500 sel 1;
#X obj 760 590 print RHO_PASS;
#X obj 860 590 print RHO_FAIL;
#X obj 740 470 expr abs($f1-5)<0.001;
#X obj 740 500 sel 1;
#X obj 480 640 print SPIN_PASS;
#X obj 620 640 print SPIN_FAIL;
