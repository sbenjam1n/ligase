#N canvas 0 0 720 620 12;
#X obj 30 20 loadbang;
#X msg 430 20 \; pd dsp 1;
#X obj 30 60 delay 50;
#X msg 200 60 env_follow_ms 900;
#X obj 30 90 delay 150;
#X msg 200 90 snapbuf_from_live;
#X obj 30 120 delay 250;
#X msg 200 120 snapbuf_set env_follow_ms 2000;
#X obj 30 150 delay 350;
#X msg 200 150 snapbuf_from_live;
#X obj 30 180 delay 450;
#X msg 200 180 snapbuf_get env_follow_ms;
#X obj 30 210 delay 700;
#X msg 200 210 \; pd quit;
#X obj 500 290 noise~;
#X obj 500 340 ligase~;
