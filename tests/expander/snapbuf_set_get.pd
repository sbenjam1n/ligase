#N canvas 0 0 720 620 12;
#X obj 30 20 loadbang;
#X msg 430 20 \; pd dsp 1;
#X obj 30 60 delay 50;
#X msg 200 60 env_follow_ms 100;
#X obj 30 90 delay 150;
#X msg 200 90 snapbuf_from_live;
#X obj 30 120 delay 250;
#X msg 200 120 snapbuf_set env_follow_ms 2000;
#X obj 30 150 delay 400;
#X msg 200 150 snapbuf_get env_follow_ms;
#X obj 30 180 delay 650;
#X msg 200 180 \; pd quit;
#X obj 500 260 noise~;
#X obj 500 310 ligase~;
#X obj 500 430 route snapbuf;
#X obj 500 460 route env_follow_ms;
#X obj 500 490 expr $f1 == 2000;
#X obj 500 520 sel 1;
#X obj 470 560 print PASS;
#X obj 570 560 print FAIL;
