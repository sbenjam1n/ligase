#X text 60 583 1 ) Audio L (Left Input) \; - Type: Audio signal \; - Also accepts: Bang messages (for clock/BPM detection) \; - Range: -1 to 1 (audio) \; - Left audio input for recording + Clock input for playhead mode 3 \;;
#X text 60 679 2 ) Audio R (Right Input) \; - Type: Audio signal \; - Range: -1 to 1 \; - Right audio input for recording \;;
#X text 60 761 3 ) GrainSize \; - Type: Control signal (float) - Range: 0.001 to 10 seconds \; - Default : 0.1 seconds \; - Duration of each grain window \;;
#X text 60 842 4 ) GrainStart \; - Type: Control signal (float) \; - Range: 0 to 1 (normalized position) \; - Default: 0.5 \; - Position within current splice where grains begin \;;
#X text 60 939 5 ) Speed \; - Type: Control signal (float) \; - Range: -4 to 4 (practical: -2 to 2.0) \; - Default: 1 \; - Playback speed and direction (negative=reverse) \;;
#X text 60 1044 6 ) Organize \; - Type: Control signal (float) \; - Range: 0 to 1 (normalized) \; - Real-time splice selection (maps to discrete splice indices) \;;
#X text 494 583 7 ) ScanRate \; - Type: Control signal (float) \; - Range: -1000 to 1000 (practical: -10 to 10.0) \; - Default: 1 \; - Scan speed for playhead mode 2 (negative=reverse) \;;
#X text 494 842 9 ) IOT (Interonset Time) \; - Type: Control signal (float) \; - Range: 0.001 to 2 seconds (min: 0.0005) \; - Default: 0.1 seconds \; - Time between grain starts (controls overlap/density) \;;
#X text 494 939 10 ) MaxGrains \; - Type: Control signal (integer as float) \; - Range: 1 to 200 (pool size dependent) \; - Default: 4 \; - Maximum concurrent grains \;;
#X text 494 1044 11 ) GDelay Time \; - Type: Control signal (float) \; - Range: 0 to 10 seconds \; - Default: 0 \; - Grain delay line time \;;
#X text 494 683 8 ) SoS (Sound-on-Sound) \; - Type: Control signal (float) \; - Range: 0 to 1 \; - Default: 0.5 (if unconnected) \; - Morphagene mode (sos_mode 1): Crossfade input and granular output \; - 1 = 100% input \; - 0.5 = 50/50 mix \; - 0 = 100% granular \; - Record Input Only mode (sos_mode 0): Mix control \;, f 63;
#X text 970 583 12 ) GDelay Feedback \; - Type: Control signal (float) \; - Range: 0 to 1 \; - Default: 0 \; - Delay feedback amount \;;
#X text 970 679 13 ) GDelay Tone \; - Type: Control signal (float) \; - Range: 0 to 1 \; - Default: 0.5 \; - Delay low-pass filter (0=dark \, 1=bright) \;;
#X text 970 776 14 ) GDelay Mix \; - Type: Control signal (float) \; - Range: 0 to 1 \; - Default: 0 \; - Delay dry/wet mix (0=dry \, 1=wet) \;;
#X text 970 872 15 ) Distortion \; - Type: Control signal (float) \; - Range: 0 to 1 \; - Default: 0 \; - Tanh saturation intensity \;;
#X text 970 967 16 ) Moog Cutoff \; - Type: Control signal (float) \; - Range: 20 to 20000 Hz \; - Default: ~1000 Hz \; - Moog ladder filter cutoff frequency \;;
#X text 970 1067 17 ) Moog Resonance \; - Type: Control signal (float) \; - Range: 0 to 4 \; - Default: 0 \; - Moog ladder filter resonance \;;
#X text 1283 583 18 ) Moog Mix \; - Type: Control signal (float) \; - Range: 0 to 1 \; - Default: 0 \; - Moog filter dry/wet mix \;;
#X text 1283 679 19 ) MIDI Pitch \; - Type: Control signal (integer as float) \; - Range: 1 to 127 (0 = unconnected) \; - MIDI note control for pitch mode 4 \;;
#X text 1283 764 20 ) Envelope Skew \; - Type: Control signal (float) \; - Range: 0 to 1 \; - Default: 0.5 \; - Envelope shape skew parameter \;;
#X text 1283 948 22 ) Pan \; - Type: Control signal (float) \; - Range: 0 to 1 \; - Default: 0.5 \; - Stereo position (0-1);
