#N canvas 100 100 800 5600 12;
#X obj 40 24 cnv 15 1480 36 empty empty ligase~ 20 12 0 14 #e0e0e0 #404040 0;
#X text 1405 32 granular synthesis;
#X text 40 78 DESCRIPTION:;
#X text 586 4061 TIMING & QUANTIZATION (IOT):;
#X text 625 4092 timesig <numerator> <denominator> - Set time signature for IOT quantization;
#X text 625 4137 quantize <subdivision> - Set IOT quantization subdivision;
#X text 625 4211 Values: 1=whole \, 2=half \, 4=quarter \, 8=eighth \, 16=sixteenth \, 32=thirty-second;
#X text 625 4166 quant <amount> - IOT quantization amount (0.0-1.0 \, 0=off \, 1=full);
#X text 586 4256 TIMING & QUANTIZATION (GRAIN SIZE):;
#X text 625 4286 gs_timesig <numerator> <denominator> - Set time signature for grain size;
#X text 625 4330 gs_quantize <subdivision> - Set grain size quantization subdivision;
#X text 625 4360 gs_quant <amount> - Grain size quantization amount (0.0-1.0);
#X text 586 4390 TIMING & QUANTIZATION (DELAY):;
#X text 625 4420 delay_timesig <numerator> <denominator> - Set time signature for delay;
#X text 625 4464 delay_quantize <subdivision> - Set delay quantization subdivision;
#X text 625 4494 delay_quant <amount> - Delay quantization amount (0.0-1.0);
#X text 64 3394 PITCH CONTROL SYSTEM:;
#X text 103 3429 pitch_mode <0|1> - Pitch control mode (0=off \, 1=enabled);
#X text 103 3474 pitch_semitones <semitones> - Set pitch in semitones (-24 to 24);
#X text 103 3504 pitch_range <min> <max> - Set pitch range in semitones;
#X text 103 3578 pitch_scale <notes...> - Define pitch scale (e.g. \, 0 2 4 5 7 9 11 for major);
#X text 636 3810 param_range dist_poly_c2 -0.5 0.5;
#X text 636 3839 param_range dist_poly_c3 0 1;
#X text 586 3621 MODE 3 CLOCK ADVANCE USAGE:;
#X text 606 3646 1 Send "playhead 3" to enable clock advance mode;
#X text 606 3705 3 Set grain size via inlet 3 or use "gs_quantize" for tempo-sync;
#X text 606 3735 4 Use "clock_advance_quant 0" for current length (default);
#X text 606 3765 5 Use "clock_advance_quant 1" for quantized length (requires gs_quantize);
#X text 606 3676 2 Connect metro to main inlet;
#X text 586 3896 INTERONSET TIME EXAMPLES:;
#X text 606 3926 iot 0.05 with grain_size 0.1 = 2x overlap (smooth);
#X text 606 3956 iot 0.025 with grain_size 0.1 = 4x overlap (very dense);
#X text 606 3985 iot 0.1 with grain_size 0.1 = grains touch (continuous);
#X text 606 4015 iot 0.2 with grain_size 0.1 = gaps between (particled);
#X text 586 3394 PLAYHEAD MODES:;
#X text 610 3416 Mode 1 (Static): Grains at fixed position \, GrainStart slides playhead;
#X text 610 3505 Mode 2 (Scanning): Playhead advances at scanrate \, GrainStart offsets grains;
#X text 610 3550 Mode 3 (Clock Advance): Playhead advances by grain length on clock bang;
#X text 640 3445 - Without clock: playhead stuck \, retriggering grains at current position;
#X text 640 3475 - With clock: playhead advances by current or quantized grain length;
#X text 610 3862 6 Without clock \, playhead stays fixed \, retriggering same position;
#N canvas 0 22 450 300 erosion_demo 1;
