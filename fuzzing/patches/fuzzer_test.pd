#N canvas 0 0 800 600 12;
#X text 20 20 ligase~ Fuzzer Test Patch;
#X text 20 40 This patch connects the fuzzer to ligase~ and runs tests;
#X msg 50 100 \; pd dsp 1;
#X text 150 100 <- Start DSP;
#X obj 50 150 loadbang;
#X msg 50 180 run 10000;
#X text 150 180 <- Run 10000 fuzz iterations;
#X obj 50 220 ligase_fuzzer~;
#X obj 350 220 ligase~;
#X text 20 270 Signal path: fuzzer outputs -> ligase inputs;
#X text 20 290 Fuzzer outlets:;
#X text 40 310 1-2: Audio L/R (to ligase~ inlets 1-2);
#X text 40 330 3: MIDI values (to ligase~ inlet 19);
#X text 40 350 4: Messages (to ligase~ inlet 1);
#X text 40 370 5: Status output;
#X connect 4 0 5 0;
#X connect 5 0 7 0;
#X connect 7 0 8 0;
#X connect 7 1 8 1;
#X connect 7 2 8 18;
#X connect 7 3 8 0;
#X obj 50 500 dac~;
#X connect 8 0 21 0;
#X connect 8 1 21 1;
#X text 20 430 Output monitoring (can hear the chaos);
#X obj 50 550 print fuzzer_status;
#X connect 7 4 25 0;
#X text 20 580 Check console for ASan/UBSan reports;
#X msg 50 250 enable_signal 1;
#X msg 50 280 enable_midi 1;
#X msg 50 310 enable_messages 1;
#X msg 50 340 seed 12345;
#X text 180 250 <- Enable signal fuzzing;
#X text 180 280 <- Enable MIDI fuzzing;
#X text 180 310 <- Enable message fuzzing;
#X text 180 340 <- Set RNG seed (reproducible tests);
