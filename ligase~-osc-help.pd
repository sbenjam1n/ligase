#N canvas 50 50 1200 900 12;
#X text 30 20 ligase~-osc - OSC Control Interface for ligase~;
#X text 30 50 Control all ligase~ parameters via Open Sound Control (OSC);
#X text 30 75 Requires: mrpeach library ([udpreceive] and [unpackOSC]);
#X text 30 100 ------------------------------------------------------------;
#X text 30 125 USAGE:;
#X text 50 150 1. Create [ligase~-osc 9000];
#X text 50 170 2. Connect outlet to [ligase~ 500] inlet;
#X text 50 190 3. Send OSC messages to port 9000;
#X text 30 220 ------------------------------------------------------------;
#X text 30 245 OSC ADDRESS SCHEME: /ligase/<category>/<parameter>;
#X text 30 280 /file:;
#X text 50 300 /ligase/file/load <symbol> -> load;
#X text 50 318 /ligase/file/save <symbol> -> save;
#X text 30 346 /transport:;
