#X text 30 3293 EXAMPLES (send with oscsend):;
#X text 50 3318 oscsend localhost 9000 /ligase/file/load s myfile.wav;
#X text 50 3336 oscsend localhost 9000 /ligase/transport/play f 1;
#X text 50 3354 oscsend localhost 9000 /ligase/grain/iot f 0.05;
#X text 50 3372 oscsend localhost 9000 /ligase/delay/time f 0.3;
#X text 50 3390 oscsend localhost 9000 /ligase/delay/feedback f 0.7;
#X text 50 3408 oscsend localhost 9000 /ligase/fog/smear_bins f 8;
#X text 50 3426 oscsend localhost 9000 /ligase/moog/cutoff f 2000;
#X text 50 3444 oscsend localhost 9000 /ligase/distortion/enable f 1;
#X text 50 3462 oscsend localhost 9000 /ligase/modulation/param_range sff speed 0.5 2.0;
#X text 50 3480 oscsend localhost 9000 /ligase/pitch/mode f 3;
#X text 50 3498 oscsend localhost 9000 /ligase/pitch/scale iiiii 0 2 4 7 9;
#X text 50 3516 oscsend localhost 9000 /ligase/nbody/epsilon ff 1 0.5;
#X text 50 3534 oscsend localhost 9000 /ligase/sphere/kick ffff 1 0.5 0.3 0.1;
#X text 50 3552 oscsend localhost 9000 /ligase/query/get_state;
