#N canvas 0 0 700 420 12;
#X obj 30 20 loadbang;
#X msg 360 20 \; pd dsp 1;
#X obj 30 300 noise~;
#X obj 30 340 ligase~;
#X obj 30 380 writesf~ 2;
#X obj 30 60 delay 50;
#X msg 30 90 open -wave -bytes 4 /tmp/ligase_mon.wav;
